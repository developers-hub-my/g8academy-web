---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-mono text-[13px] tracking-widest text-eyebrow uppercase">404</p>
    <h1 class="mt-4 text-[clamp(34px,5vw,48px)] leading-tight font-extrabold tracking-[-0.035em] text-navy">This page does not exist</h1>
    <p class="mt-4 max-w-md text-[16px] leading-relaxed text-muted">
      If you were checking a credential, the verification link has the form
      <span class="font-mono text-[14px] text-navy">/verify/&lt;id&gt;</span>. A revoked credential
      still resolves, so a missing page means the link itself is wrong.
    </p>
    <a href="/" class="mt-8 rounded-[12px] bg-navy px-6 py-3.5 text-[15px] font-bold text-page transition-opacity duration-200 hover:opacity-90">
      Back to the homepage
    </a>
  </section>
</Base>
