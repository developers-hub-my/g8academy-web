---
import Base from './Base.astro';
import { docs } from '../data/docs';

/** Markdown pages pass `frontmatter`; .astro pages pass title/description. */
interface Props {
  frontmatter?: { title: string; description?: string };
  title?: string;
  description?: string;
}
const fm = Astro.props.frontmatter ?? Astro.props;
const here = Astro.url.pathname.replace(/\/?$/, '/');
---
<Base title={`${fm.title} · Guide`} description={fm.description}>
  <div class="bg-page">
    <div class="container-page grid gap-10 py-10 lg:grid-cols-[15rem_minmax(0,1fr)] lg:py-14">
      <nav aria-label="Guides" class="lg:sticky lg:top-24 lg:self-start">
        <p class="font-mono text-[12px] tracking-wider text-muted uppercase">How to use</p>
        <ul class="mt-3 flex flex-wrap gap-1 lg:flex-col">
          {docs.map((d) => (
            <li>
              <a
                href={d.href}
                aria-current={d.href === here ? 'page' : undefined}
                class:list={[
                  'block rounded-[8px] px-3 py-2 text-[15px] font-medium transition-colors duration-150',
                  d.href === here ? 'bg-tint text-tint-fg' : 'text-ink hover:bg-surface-2 hover:text-navy',
                ]}
              >{d.label}</a>
            </li>
          ))}
        </ul>
      </nav>
      <article class="docs-prose min-w-0 max-w-3xl">
        <slot />
      </article>
    </div>
  </div>
</Base>
