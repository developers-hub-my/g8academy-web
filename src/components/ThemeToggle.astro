---
/**
 * Light/dark switch. The palette already follows prefers-color-scheme, so this
 * only exists to override the OS — the stored value is read before first paint
 * by the inline script in Base.astro.
 */
---
<button
  id="theme-toggle"
  type="button"
  class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-[8px] border border-line text-navy transition-colors duration-200 hover:text-primary"
  aria-label="Toggle dark mode"
>
  <svg
    class="icon-light h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg
    class="icon-dark h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    // Read what is actually painted, not what is stored — a visitor who has
    // never chosen has no class, and the OS decides.
    const dark = getComputedStyle(root).colorScheme.includes('dark');
    const next = dark ? 'light' : 'dark';
    root.classList.remove('light', 'dark');
    root.classList.add(next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* private mode — the choice lasts for this page only */
    }
  });
</script>
