---
/**
 * The public verify page, rendered as a static preview inside a browser frame.
 * Status comes FIRST and always carries a word, never colour alone
 * (documentation/02-design/02-ui-design-system.md — BR-13 / NFR-ACC-03).
 */
import { levels, site } from '../data/site';

const level = levels[1];
const id = '9f2c4b71-8e3a-4d20-b6f1-2c7a5e0d9134';
const rows = [
  ['Issued', '14 August 2026'],
  ['Valid until', 'No expiry set'],
  ['Assessment', `${level.assessment} · scored 86%`],
  ['Issued by', site.company],
];
---
<figure class="overflow-hidden rounded-[16px] border border-line bg-surface shadow-[0_30px_60px_rgba(15,16,45,.12)]">
  <figcaption class="sr-only">Example of a public credential verification page</figcaption>
  <div class="flex items-center gap-3 border-b border-line bg-surface-2 px-4 py-3" aria-hidden="true">
    <span class="flex gap-1.5"><i class="h-2.5 w-2.5 rounded-full bg-line-strong"></i><i class="h-2.5 w-2.5 rounded-full bg-line-strong"></i><i class="h-2.5 w-2.5 rounded-full bg-line-strong"></i></span>
    <span class="min-w-0 flex-1 truncate rounded-[6px] bg-surface px-2.5 py-2 font-mono text-[12px] text-muted">
      {site.url.replace('https://', '')}/verify/{id}
    </span>
  </div>
  <div class="flex flex-col gap-[22px] p-5 sm:p-8">
    <p class="flex flex-wrap items-center gap-3 rounded-[12px] bg-verified-bg px-4 py-3.5 text-verified">
      <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor" /><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="text-[15px] font-bold">Verified</span>
      <span class="ml-auto text-[13px]">Signature checked just now</span>
    </p>
    <div class="flex flex-wrap items-center gap-[18px]">
      <span class="flex h-[72px] w-[72px] flex-none items-center justify-center rounded-[16px] bg-midnight">
        <img src={level.mark} alt={`${level.name} level`} class="h-9 w-auto" width="19" height="36" />
      </span>
      <div class="min-w-0">
        <p class="text-[13px] text-muted">Nur Aisyah binti Rahman holds</p>
        <p class="text-[26px] font-extrabold tracking-[-0.03em] text-navy">{level.name}</p>
        <p class="text-[15px] text-ink">API Design, Security &amp; Operations</p>
      </div>
    </div>
    <dl class="grid grid-cols-2 gap-4 border-t border-line pt-[18px]">
      {rows.map(([k, v]) => (
        <div class="min-w-0">
          <dt class="text-[12px] text-muted">{k}</dt>
          <dd class="mt-1 text-[15px] font-semibold break-words text-navy">{v}</dd>
        </div>
      ))}
    </dl>
    <p class="font-mono text-[12px] text-muted">Open Badge 3.0 · api-design v1.0</p>
  </div>
</figure>
