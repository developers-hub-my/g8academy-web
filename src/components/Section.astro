---
/** A light band with the shared eyebrow + display heading. */
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lede?: string;
  center?: boolean;
  surface?: boolean;
}
const { id, eyebrow, title, lede, center = false, surface = false } = Astro.props;
---
<section
  id={id}
  class:list={['section-y scroll-mt-20', surface ? 'border-y border-line bg-surface' : 'bg-page']}
  aria-labelledby={`${id}-heading`}
>
  <div class="container-page">
    <header
      class:list={[
        'mb-10 flex flex-wrap gap-6 md:mb-12',
        center ? 'mx-auto max-w-2xl justify-center text-center' : 'items-end justify-between',
      ]}
    >
      <div class="max-w-2xl">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h2 id={`${id}-heading`} class="h-display mt-3 text-navy">{title}</h2>
      </div>
      {lede && <p class="max-w-[30em] text-[17px] leading-relaxed text-muted">{lede}</p>}
      <slot name="aside" />
    </header>
    <slot />
  </div>
</section>
