---
import VerifyCard from '../VerifyCard.astro';
import { site } from '../../data/site';

const points = [
  { t: 'A unique ID', d: 'Every credential gets one, printed on the certificate.' },
  { t: 'Live status', d: 'Verified, expired or revoked, always current.' },
  { t: 'What was tested', d: 'Level, series version and how it was assessed.' },
  { t: 'No account needed', d: 'Anyone with the link or ID can check.' },
];
---
<section id="credentials" class="section-y scroll-mt-20 border-y border-line bg-surface" aria-labelledby="credentials-heading">
  <div class="container-page flex flex-wrap items-center gap-16">
    <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-5">
      <p class="eyebrow">Credentials</p>
      <h2 id="credentials-heading" class="h-display text-navy">A credential anyone can check in one click.</h2>
      <p class="text-[17px] leading-relaxed text-muted">
        Every credential is a signed Open Badge 3.0 with its own public page. Put the link on your CV
        or LinkedIn. A hiring manager sees what you passed, at which level and when, without
        emailing anyone. The signature is checked against our published key, not a database lookup.
      </p>
      <ul class="grid gap-3.5 sm:grid-cols-2">
        {points.map((p) => (
          <li class="flex items-start gap-3 text-[15px] leading-normal">
            <span class="flex h-7 w-7 flex-none items-center justify-center rounded-[8px] bg-tint text-eyebrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span><b class="text-navy">{p.t}</b><br /><span class="text-muted">{p.d}</span></span>
          </li>
        ))}
      </ul>

      {/* Without JS this submits ?id=… to /verify; the script turns it into the
          canonical /verify/<id> path, and accepts a pasted verify link too. */}
      <form id="verify" action={`${site.app}/verify`} method="get" class="flex scroll-mt-24 flex-wrap gap-2.5 pt-2" data-app={site.app}>
        <label for="cred-id" class="sr-only">Credential ID or verify link</label>
        <input
          id="cred-id"
          name="id"
          type="text"
          required
          autocomplete="off"
          spellcheck="false"
          placeholder="Credential ID or verify link"
          class="min-w-0 flex-[1_1_240px] rounded-[12px] border border-line-strong bg-surface px-4 py-[15px] font-mono text-[15px] text-navy placeholder:text-muted"
        />
        <button type="submit" class="cursor-pointer rounded-[12px] bg-navy px-[22px] py-[15px] text-[15px] font-bold text-page transition-opacity duration-200 hover:opacity-90">
          Verify
        </button>
      </form>
    </div>
    <div class="relative isolate min-w-0 flex-[1_1_460px] pr-6 pb-10 sm:pr-12 sm:pb-14">
      {/* Photo: Resume Genius on Unsplash (credits in README.md) */}
      <div class="absolute right-0 bottom-0 -z-10 h-[70%] w-[85%] overflow-hidden rounded-[22px] bg-midnight" aria-hidden="true">
        <img src="/images/landing/credentials.jpg" alt="" loading="lazy" decoding="async" width="1000" height="750" class="h-full w-full object-cover opacity-70" />
        <span class="absolute inset-0 bg-gradient-to-tl from-midnight/30 to-midnight/80"></span>
      </div>
      <VerifyCard />
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('verify') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    const raw = (form.elements.namedItem('id') as HTMLInputElement).value.trim();
    const id = raw.split('/verify/').pop()?.split(/[?#/]/)[0];
    if (!id) return;
    e.preventDefault();
    location.href = `${form.dataset.app}/verify/${encodeURIComponent(id)}`;
  });
</script>
