---
import Section from '../Section.astro';
import { levelByName, site } from '../../data/site';

/* Launch catalogue. Nothing here claims to be live yet.
   Header photos: Unsplash, credits in README.md. */
const series = [
  { glyph: 'DKR', photo: '/images/landing/series-docker.jpg', level: 'Fundamentals', topic: 'Containers', title: 'Docker & Container Fundamentals', blurb: 'Images, volumes, networks and Compose, from your laptop to a staging server.' },
  { glyph: 'LRV', photo: '/images/landing/series-laravel.jpg', level: 'Fundamentals', topic: 'Laravel', title: 'Laravel Application Foundations', blurb: 'Routing, Eloquent, validation and testing with Pest, the way production teams write it.' },
  { glyph: 'API', photo: '/images/landing/series-api.jpg', level: 'Practitioner', topic: 'APIs', title: 'API Design, Security & Operations', blurb: 'Contracts, versioning, auth, rate limits and monitoring for APIs other teams depend on.' },
  { glyph: 'IAM', photo: '/images/landing/series-identity.jpg', level: 'Practitioner', topic: 'Identity', title: 'Identity with Keycloak', blurb: 'Realms, clients, SSO and token flows, connected to Laravel and your existing directory.' },
  { glyph: 'GWY', photo: '/images/landing/series-gateway.jpg', level: 'Practitioner', topic: 'APIs', title: 'Kong API Gateway in Production', blurb: 'Routes, plugins, consumers and observability behind a gateway you can actually operate.' },
  { glyph: 'ARC', photo: '/images/landing/series-architecture.jpg', level: 'Architect', topic: 'Architecture', title: 'Platform Architecture for Laravel Teams', blurb: 'Service boundaries, queues, multi-tenancy and the decisions you defend in a design review.' },
];
const topics = ['All', 'Laravel', 'APIs', 'Identity', 'Containers', 'Architecture'];
// Glyph colour = the level's bar on midnight (all ≥ 3:1 at 40px bold).
const glyphColour: Record<string, string> = { Fundamentals: 'text-[#51a2ff]', Practitioner: 'text-[#8e8cff]', Architect: 'text-coral' };
---
<Section id="series" eyebrow="Series" title="Start where you are.">
  <a slot="aside" href={`${site.app}/catalogue`} class="py-3 text-[15px] font-bold text-primary hover:underline">
    See all series <span aria-hidden="true">→</span>
  </a>

  <div role="group" aria-label="Filter by topic" class="mb-7 flex flex-wrap gap-2" id="series-filter">
    {topics.map((t, i) => (
      <button
        type="button"
        data-topic={t}
        aria-pressed={i === 0 ? 'true' : 'false'}
        class="cursor-pointer rounded-full border border-line-strong bg-surface px-4 py-3 text-[14px] leading-none font-semibold text-navy transition-colors duration-200 hover:border-navy aria-pressed:border-navy aria-pressed:bg-navy aria-pressed:text-page"
      >
        {t}
      </button>
    ))}
  </div>
  <p id="series-status" class="sr-only" aria-live="polite"></p>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" id="series-list">
    {series.map((s) => (
      <li data-topic={s.topic} class="flex flex-col overflow-hidden rounded-[18px] border border-line bg-surface">
        <div class="relative isolate flex aspect-[2/1] items-end justify-between overflow-hidden bg-midnight p-5">
          <img src={s.photo} alt="" aria-hidden="true" loading="lazy" decoding="async" width="800" height="400" class="absolute inset-0 -z-10 h-full w-full object-cover" />
          <span class="absolute inset-0 -z-10 bg-gradient-to-t from-midnight via-midnight/85 to-midnight/60" aria-hidden="true"></span>
          <span class:list={['text-[40px] leading-none font-extrabold tracking-[-0.04em]', glyphColour[s.level]]} aria-hidden="true">{s.glyph}</span>
          <img src={levelByName[s.level].mark} alt="" class="h-[34px] w-auto" width="18" height="34" />
        </div>
        <div class="flex flex-1 flex-col gap-2.5 px-[22px] pt-5 pb-[22px]">
          <div class="flex flex-wrap gap-2">
            <span class="rounded-[6px] bg-tint px-[9px] py-[5px] text-[12px] font-bold text-navy">{s.level}</span>
            <span class="rounded-[6px] bg-page px-[9px] py-[5px] text-[12px] font-semibold text-muted">{s.topic}</span>
          </div>
          <h3 class="text-[20px] leading-tight font-bold tracking-[-0.015em] text-navy">{s.title}</h3>
          <p class="text-[14px] leading-normal text-muted">{s.blurb}</p>
          <div class="mt-auto flex justify-between border-t border-line pt-3 font-mono text-[12px] text-muted">
            <span>{levelByName[s.level].hours} · free preview at launch</span><span>Credential <span aria-hidden="true">✓</span></span>
          </div>
        </div>
      </li>
    ))}
  </ul>
</Section>

<script>
  const filter = document.getElementById('series-filter');
  const items = document.querySelectorAll<HTMLElement>('#series-list > li');
  const status = document.getElementById('series-status');
  filter?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-topic]');
    if (!btn) return;
    const topic = btn.dataset.topic;
    filter.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    let shown = 0;
    items.forEach((li) => {
      const match = topic === 'All' || li.dataset.topic === topic;
      li.hidden = !match;
      if (match) shown++;
    });
    if (status) status.textContent = `Showing ${shown} series${topic === 'All' ? '' : ` in ${topic}`}.`;
  });
</script>
