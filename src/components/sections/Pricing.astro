---
import Section from '../Section.astro';
import { site } from '../../data/site';

const plans = [
  { name: 'Monthly', price: 'RM 39', period: '/ month', blurb: 'All-access video while you need it.', features: ['Every series, every episode', 'Progress, resume and captions', 'Code and config for every episode'], cta: 'Start monthly', featured: false },
  { name: 'Annual', price: 'RM 349', period: '/ year', blurb: 'All-access video for a year.', features: ['Everything in Monthly', '25% below the monthly rate', 'One payment a year'], cta: 'Start annual', featured: true },
  { name: 'Lifetime', price: 'RM 1,745', period: 'once', blurb: 'All-access video, permanently.', features: ['Everything in Annual', 'One payment, no renewal'], cta: 'Buy lifetime', featured: false },
  { name: 'Per credential', price: 'RM 149–399', period: 'by level', blurb: 'One competency. No subscription.', features: ['The series and its assessment', '2 assessment attempts included', 'Signed credential on pass', 'Fundamentals 149 · Practitioner 249 · Architect 399'], cta: 'Buy a credential', featured: false },
];
const check = 'M5 12.5l4.5 4.5L19 7.5';
---
<Section id="pricing" eyebrow="Pricing" title="One plan for you. One for your team." center surface>
  <p class="mx-auto -mt-4 mb-10 max-w-2xl text-center text-[17px] leading-relaxed text-muted">
    A subscription buys the video. The assessment and the credential, what an employer actually
    checks, are bought per credential. No subscription includes an assessment.
  </p>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {plans.map((p) => (
      <li class:list={['flex flex-col gap-4 rounded-[20px] bg-surface p-7', p.featured ? 'border-2 border-navy' : 'border border-line-strong']}>
        <div class="flex items-center justify-between gap-3">
          <h3 class="text-[20px] font-extrabold text-navy">{p.name}</h3>
          {p.featured && <span class="rounded-full bg-tint px-2.5 py-1 text-[12px] font-bold text-tint-fg">Best value</span>}
        </div>
        <p class="flex flex-wrap items-baseline gap-x-1.5">
          <span class="text-[34px] leading-none font-extrabold tracking-[-0.04em] whitespace-nowrap text-navy">{p.price}</span>
          <span class="text-[15px] text-muted">{p.period}</span>
        </p>
        <p class="text-[14px] text-muted">{p.blurb}</p>
        <ul class="flex flex-col gap-2.5 border-t border-line pt-4 text-[14px] text-ink">
          {p.features.map((f) => (
            <li class="flex gap-2.5">
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="mt-0.5 flex-none text-eyebrow"><path d={check} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={`${site.app}/catalogue`}
          class:list={[
            'mt-auto rounded-[12px] px-4 py-3.5 text-center text-[15px] font-bold transition-opacity duration-200 hover:opacity-90',
            p.featured ? 'bg-navy text-page' : 'border border-line-strong text-navy',
          ]}
        >
          {p.cta}
        </a>
      </li>
    ))}
  </ul>

  <article class="on-midnight mt-5 flex flex-wrap items-center gap-x-10 gap-y-6 rounded-[20px] bg-midnight p-7 text-white sm:p-8" aria-labelledby="teams-plan">
    <div class="flex-[1_1_320px]">
      <div class="flex flex-wrap items-center gap-3">
        <h3 id="teams-plan" class="text-[22px] font-extrabold">Teams &amp; organisations</h3>
        <span class="rounded-full bg-coral px-2.5 py-1.5 text-[12px] font-bold text-midnight">Invoice billing</span>
      </div>
      <p class="mt-2 text-[15px] text-midnight-ink">Priced by seats and cohort size. Tell us your team and window, and we will quote.</p>
    </div>
    <ul class="grid flex-[2_1_420px] gap-x-6 gap-y-2.5 text-[15px] text-midnight-ink sm:grid-cols-2">
      {['Seats you can reassign', 'Single sign-on with your identity provider', 'Cohorts, assignments and progress reports', 'Invoice billing for organisations'].map((f) => (
        <li class="flex gap-2.5">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="mt-1 flex-none text-coral"><path d={check} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {f}
        </li>
      ))}
    </ul>
    <a href={`mailto:${site.email}?subject=DevHub%20Academy%20for%20teams`} class="rounded-[12px] bg-coral px-6 py-4 text-center text-[16px] font-bold text-midnight transition-opacity duration-200 hover:opacity-90">
      Talk to us
    </a>
  </article>

  <p class="mt-6 text-center text-[13px] leading-relaxed text-muted">
    All prices in MYR, excluding SST. Every transaction produces an LHDN e-Invoice. Extra assessment
    attempts are RM 49. Refundable within 7 days if under 20% of a series is watched, but not once
    an assessment attempt has started.
  </p>
</Section>
