---
import Section from '../Section.astro';
import { faqs } from '../../data/site';
---
<Section
  id="faq"
  eyebrow="Questions"
  title="The things people ask first"
>
  <div class="grid gap-3 md:grid-cols-2 md:gap-x-6">
    {faqs.map((f) => (
      <details class="group rounded-[12px] border border-line bg-surface p-5 open:bg-surface-2">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-4 text-[15px] font-semibold text-navy"
        >
          <span>{f.q}</span>
          <svg
            viewBox="0 0 20 20"
            class="mt-1 h-4 w-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-180"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M5 7.5l5 5 5-5"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </summary>
        <p class="mt-3 text-[14px] leading-relaxed text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</Section>
