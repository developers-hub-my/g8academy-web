---
import { faqs } from '../../data/site';
---
<section id="faq" class="section-y scroll-mt-20 bg-page" aria-labelledby="faq-heading">
  <div class="container-page max-w-[860px]">
    <h2 id="faq-heading" class="mb-7 text-[clamp(28px,3.4vw,40px)] leading-tight font-extrabold tracking-[-0.03em] text-navy">Questions</h2>
    <div class="flex flex-col gap-2.5">
      {faqs.map((f) => (
        <details class="group rounded-[14px] border border-line bg-surface px-5 sm:px-[22px]">
          <summary class="flex cursor-pointer items-start justify-between gap-4 rounded-[10px] py-5 text-[17px] font-bold text-navy">
            <span>{f.q}</span>
            <svg viewBox="0 0 20 20" class="mt-1 h-4 w-4 flex-none text-muted transition-transform duration-200 group-open:rotate-180" fill="none" aria-hidden="true">
              <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <p class="mb-5 text-[15px] leading-relaxed text-muted">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
