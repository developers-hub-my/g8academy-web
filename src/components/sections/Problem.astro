---
import Section from '../Section.astro';

const items = [
  {
    claim: 'Learning happens. Proof of learning does not.',
    body: 'There is no shortage of long-form video for Malaysian developers. There is almost nothing short, assessed and employer-verifiable.',
  },
  {
    claim: 'University portals assess, but are semester-shaped.',
    body: 'They are built around enrolment and terms. Working developers do not enrol, so the assessment never reaches them.',
  },
  {
    claim: 'PDF certificates are forwarded, not checked.',
    body: 'A PDF cannot be distinguished from a convincing forgery without picking up the phone. So nobody checks, and the certificate stops meaning anything.',
  },
];
---
<Section
  id="problem"
  alt
  eyebrow="The gap"
  title="The problem was never the content"
  lede="It is that nothing at the end of it holds up to scrutiny."
>
  <div class="grid gap-px overflow-hidden rounded-[12px] border border-line bg-line md:grid-cols-3">
    {items.map((i) => (
      <div class="bg-surface p-7">
        <p class="text-[17px] leading-snug font-semibold text-navy">{i.claim}</p>
        <p class="mt-3 text-[14px] leading-relaxed text-muted">{i.body}</p>
      </div>
    ))}
  </div>
</Section>
