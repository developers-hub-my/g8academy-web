---
import Section from '../Section.astro';
import { levels } from '../../data/site';
---
<Section
  id="levels"
  eyebrow="Level taxonomy"
  title="Four levels, each with a stated prerequisite"
  lede="The level sets what is assumed of you going in, the notional hours, and whether a practical assessment is required. Credential price follows the level, not the series."
>
  <div class="overflow-x-auto rounded-[12px] border border-line">
    <table class="w-full min-w-[46rem] border-collapse text-left">
      <caption class="sr-only">G8Academy credential levels, prerequisites, hours and price</caption>
      <thead>
        <tr class="border-b border-line bg-surface-2">
          <th scope="col" class="px-5 py-3.5 text-[13px] font-semibold text-navy">Level</th>
          <th scope="col" class="px-5 py-3.5 text-[13px] font-semibold text-navy">Assumed of you</th>
          <th scope="col" class="px-5 py-3.5 text-[13px] font-semibold text-navy">Hours</th>
          <th scope="col" class="px-5 py-3.5 text-[13px] font-semibold text-navy">Assessment</th>
          <th scope="col" class="px-5 py-3.5 text-right text-[13px] font-semibold text-navy">
            Credential
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line bg-surface">
        {levels.map((l) => (
          <tr>
            <th scope="row" class="px-5 py-4">
              <span
                class="inline-block rounded-full bg-tint px-2.5 py-1 text-[13px] font-semibold text-primary"
              >
                {l.name}
              </span>
            </th>
            <td class="px-5 py-4 text-[14px] text-muted">{l.prerequisite}</td>
            <td class="px-5 py-4 font-mono text-[13px] text-muted">{l.hours}</td>
            <td class="px-5 py-4 text-[14px] text-muted">
              {l.practical ? 'Quiz + practical' : 'Timed quiz'}
            </td>
            <td class="px-5 py-4 text-right font-mono text-[14px] font-medium text-ink">
              RM {l.price}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="mt-4 text-[13px] text-muted">
    Pathways stack several series into a single higher-order credential. Prices exclude SST.
  </p>
</Section>
