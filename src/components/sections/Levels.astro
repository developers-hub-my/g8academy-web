---
import { levels } from '../../data/site';
---
<section id="levels" class="on-midnight section-y scroll-mt-20 bg-midnight text-white" aria-labelledby="levels-heading">
  <div class="container-page">
    <header class="mb-12 max-w-[720px]">
      <p class="eyebrow text-mist">Three levels</p>
      <h2 id="levels-heading" class="h-display mt-3">The bars in our logo are the path.</h2>
      <p class="mt-[18px] text-[17px] leading-relaxed text-midnight-ink">
        Each credential lights another bar. Earn all three and you hold the full mark.
      </p>
    </header>
    <ul class="grid gap-5 md:grid-cols-3">
      {levels.map((l) => (
        <li class="flex flex-col gap-[18px] rounded-[18px] border border-midnight-line bg-midnight-2 p-7 sm:p-8">
          <img src={l.mark} alt="" class="h-16 w-auto self-start" width="34" height="64" />
          <div>
            <p class="font-mono text-[12px] text-mist">Level {l.n}</p>
            <h3 class="mt-2 text-[28px] font-extrabold tracking-[-0.03em]">{l.name}</h3>
          </div>
          <p class="text-[18px] leading-snug font-semibold">{l.claim}</p>
          <p class="text-[15px] leading-relaxed text-mist">{l.body}</p>
          <dl class="mt-auto grid grid-cols-3 gap-2 border-t border-midnight-line pt-4 font-mono text-[12px]">
            <div><dt class="text-mist">Hours</dt><dd class="mt-1 text-white">{l.hours}</dd></div>
            <div><dt class="text-mist">Assessed</dt><dd class="mt-1 text-white">{l.assessment}</dd></div>
            <div><dt class="text-mist">Credential</dt><dd class="mt-1 text-white">RM {l.price}</dd></div>
          </dl>
        </li>
      ))}
    </ul>
  </div>
</section>
