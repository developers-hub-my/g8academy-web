---
import Section from '../Section.astro';
import { steps } from '../../data/site';
---
<Section
  id="how"
  eyebrow="How it works"
  title="Watching isn’t the finish line. Proving it is."
  lede="Every series ends in an assessment. Pass it and you get a credential with its own public page."
>
  <ol class="grid gap-5 md:grid-cols-3">
    {steps.map((s) => (
      <li class="flex flex-col overflow-hidden rounded-[18px] border border-line bg-surface">
        <div class="relative aspect-[16/9] bg-midnight">
          <img src={s.photo} alt={s.photoAlt} loading="lazy" decoding="async" width="800" height="450" class="h-full w-full object-cover" />
          <span class="absolute inset-0 bg-midnight/25" aria-hidden="true"></span>
        </div>
        <div class="flex flex-1 flex-col gap-4 p-7 sm:p-8">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[13px] text-muted">{s.n}</span>
          <span class:list={['h-1.5 w-10 rounded-[3px]', s.bar]} aria-hidden="true"></span>
        </div>
        <h3 class="text-[30px] font-extrabold tracking-[-0.03em] text-navy">{s.title}</h3>
        <p class="text-[16px] leading-relaxed text-ink">{s.body}</p>
        <ul class="flex flex-col gap-2.5 border-t border-line pt-4">
          {s.points.map((p) => (
            <li class="flex gap-2.5 text-[14px] leading-normal text-muted">
              <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" class="mt-0.5 flex-none text-eyebrow">
                <path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {p}
            </li>
          ))}
        </ul>
        </div>
      </li>
    ))}
  </ol>
</Section>
