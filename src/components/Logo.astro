---
import BrandMark from './BrandMark.astro';

interface Props {
  class?: string;
  /** Wordmark + tagline stack, as in the application sidebar. Off by default. */
  tagline?: boolean;
}
const { class: cls = '', tagline = false } = Astro.props;
---
<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <BrandMark class="h-8 w-8" />
  <span class="flex flex-col leading-none">
    <span class="text-[17px] font-bold tracking-tight text-navy">G8Academy</span>
    {tagline && <span class="mt-1 text-[11px] text-muted">Learn it. Prove it.</span>}
  </span>
</span>
