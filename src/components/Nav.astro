---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../data/site';

const links = [
  { href: '/#series', label: 'Series' },
  { href: '/#how', label: 'How it works' },
  { href: '/#credentials', label: 'Credentials' },
  { href: '/#teams', label: 'For teams' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/docs/', label: 'Guides' },
];
const start = `${site.app}/catalogue`;
---
<header class="on-midnight sticky top-0 z-40 border-b border-midnight-line bg-midnight/95 backdrop-blur-md">
  <nav class="container-page flex h-[72px] items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="shrink-0 rounded-[6px]" aria-label={`${site.name} home`}>
      <Logo class="h-[22px] sm:h-[26px]" />
    </a>

    <ul class="hidden items-center gap-7 text-[15px] font-medium xl:flex">
      {links.map((l) => (
        <li>
          <a href={l.href} class="text-midnight-ink transition-colors duration-200 hover:text-white">{l.label}</a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-2">
      <a href="/#verify" class="hidden px-2.5 py-3 text-[14px] font-medium text-midnight-ink transition-colors duration-200 hover:text-white lg:inline-block">
        Verify a credential
      </a>
      <a href={site.app} class="hidden rounded-[10px] border border-[#3b3e6b] px-4 py-3 text-[14px] font-semibold text-white transition-colors duration-200 hover:border-mist sm:inline-block">
        Sign in
      </a>
      <a href={start} class="hidden rounded-[10px] bg-coral px-[18px] py-3 text-[14px] font-bold whitespace-nowrap text-midnight transition-opacity duration-200 hover:opacity-90 sm:inline-block">
        Start learning
      </a>
      <ThemeToggle />

      {/* Mobile menu: native <details> — keyboard operable and announced as
          expanded/collapsed with no JS. The script only closes it after a jump. */}
      <details id="mobile-menu" class="relative xl:hidden">
        <summary
          class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-[10px] border border-[#3b3e6b] text-white"
          aria-label="Menu"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <div class="fixed inset-x-0 top-[72px] z-40 max-h-[calc(100dvh-72px)] overflow-y-auto border-b border-midnight-line bg-midnight p-4 shadow-2xl">
          <ul class="flex flex-col">
            {links.map((l) => (
              <li>
                <a href={l.href} class="block rounded-[8px] px-3 py-3 text-[16px] font-medium text-midnight-ink hover:bg-midnight-2 hover:text-white">{l.label}</a>
              </li>
            ))}
            <li class="lg:hidden">
              <a href="/#verify" class="block rounded-[8px] px-3 py-3 text-[16px] font-medium text-midnight-ink hover:bg-midnight-2 hover:text-white">Verify a credential</a>
            </li>
            <li class="mt-3 grid gap-2 border-t border-midnight-line pt-4 sm:hidden">
              <a href={site.app} class="block rounded-[10px] border border-[#3b3e6b] px-4 py-3 text-center text-[15px] font-semibold text-white">Sign in</a>
              <a href={start} class="block rounded-[10px] bg-coral px-4 py-3 text-center text-[15px] font-bold text-midnight">Start learning</a>
            </li>
          </ul>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  const menu = document.getElementById('mobile-menu') as HTMLDetailsElement | null;
  if (menu) {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
    matchMedia('(min-width: 80rem)').addEventListener('change', (e) => {
      if (e.matches) menu.open = false;
    });
  }
</script>
