---
import Logo from './Logo.astro';
import { site } from '../data/site';

const cols = [
  {
    title: 'Learn',
    links: [
      { href: '/#series', label: 'Series' },
      { href: '/#how', label: 'How it works' },
      { href: '/#pricing', label: 'Pricing' },
    ],
  },
  {
    title: 'Credentials',
    links: [
      { href: '/#verify', label: 'Verify a credential' },
      { href: '/#levels', label: 'Levels' },
      { href: 'https://www.imsglobal.org/spec/ob/v3p0/', label: 'Open Badges 3.0' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/#teams', label: 'For teams' },
      { href: 'https://devhub.my', label: 'devhub.my' },
      { href: `mailto:${site.email}`, label: 'Contact' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer id="contact" class="on-midnight bg-midnight text-white">
  <div class="container-page flex flex-wrap justify-between gap-10 pt-12 pb-14">
    <div class="flex flex-[1_1_260px] flex-col gap-4">
      <Logo variant="stacked-endorsed" class="h-16 self-start" />
      <p class="text-[13px] leading-relaxed text-mist">
        {site.company} ({site.registration})<br />{site.location}
      </p>
    </div>
    <nav aria-label="Footer" class="flex flex-wrap gap-x-14 gap-y-8 text-[14px]">
      {cols.map((c) => (
        <div>
          <h2 class="font-bold text-white">{c.title}</h2>
          <ul class="mt-3 space-y-2.5">
            {c.links.map((l) => (
              <li>
                <a href={l.href} class="text-mist transition-colors duration-200 hover:text-white">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="container-page border-t border-midnight-line py-6 text-[13px] text-mist">
    <p class="flex flex-wrap justify-between gap-x-6 gap-y-2">
      <span>&copy; {year} {site.company}. All rights reserved.</span>
      <a href="https://unsplash.com/?utm_source=devhub_academy&utm_medium=referral" class="transition-colors duration-200 hover:text-white">Photos from Unsplash</a>
    </p>
  </div>
</footer>
